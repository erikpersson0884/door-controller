{
    "name": "doorcontroll",
    "version": "1.0.0",
    "scripts": {
        "setup": "npm install && cd client && npm install && cd ../server && npm install",
        "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
        "dev:client": "cd client && npm run dev",
        "dev:server": "cd server && npm run dev"
    },
    "devDependencies": {
        "concurrently": "^10.0.6"
    }
}
